<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:src="@drawable/ic_logo" android:contentDescription="ITthute logo"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="ITthute Media Splitter" android:textSize="24sp" android:textStyle="bold"/><Button android:id="@+id/selectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Choose media file"/><TextView android:id="@+id/fileLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No file selected"/><EditText android:id="@+id/startTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Start time: seconds or HH:MM:SS" android:inputType="text" android:text="0"/><EditText android:id="@+id/endTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="End time: seconds or HH:MM:SS" android:inputType="text"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Audio output format" android:textStyle="bold"/><Spinner android:id="@+id/audioFormat" android:layout_width="match_parent" android:layout_height="48dp"/><Button android:id="@+id/exportAudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save trimmed audio"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Silent video output format" android:textStyle="bold"/><Spinner android:id="@+id/videoFormat" android:layout_width="match_parent" android:layout_height="48dp"/><Button android:id="@+id/exportVideoButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save trimmed silent video"/><ProgressBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/><TextView android:id="@+id/statusLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready"/><Button android:id="@+id/cancelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancel" android:visibility="gone"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="All processing happens locally on your device."/></LinearLayout></ScrollView>
