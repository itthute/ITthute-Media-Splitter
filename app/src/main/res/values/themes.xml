<resources>
    <style name="Theme.ITthuteMediaSplitter" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/itthute_blue</item>
        <item name="colorOnPrimary">@color/itthute_on_primary</item>
        <item name="colorSecondary">@color/itthute_teal</item>
        <item name="android:statusBarColor">@color/itthute_navy</item>
        <item name="android:navigationBarColor">@color/itthute_navy</item>
        <item name="materialButtonStyle">@style/Widget.ITthute.Button</item>
    </style>

    <style name="Widget.ITthute.Button" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/itthute_on_primary</item>
    </style>

    <style name="Widget.ITthute.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ITthute.PageTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
